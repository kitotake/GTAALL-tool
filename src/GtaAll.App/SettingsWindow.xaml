<Window x:Class="GtaAll.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Paramètres" Width="640" Height="780" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,6,0">

        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10" Padding="14">
          <StackPanel>
            <TextBlock Text="Modules" Style="{StaticResource PanelTitle}"/>
            <StackPanel x:Name="ModulesHost" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <!-- ===== Apparence ===== -->
        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10" Padding="14">
          <StackPanel>
            <TextBlock Text="Apparence" Style="{StaticResource PanelTitle}"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                       Text="Les changements s'appliquent tout de suite et ne sont conservés qu'avec « Enregistrer »."/>

            <TextBlock Text="Thème principal" Margin="0,0,0,4"/>
            <ComboBox x:Name="ThemeBox" DisplayMemberPath="Label" SelectedValuePath="Key" Width="280"
                      HorizontalAlignment="Left" SelectionChanged="Theme_Changed"/>

            <CheckBox x:Name="FollowBox" Content="Suivre automatiquement le thème de Windows" Margin="0,12,0,0" Click="Follow_Click"/>
            <StackPanel x:Name="DarkRow" Margin="28,8,0,0" Visibility="Collapsed">
              <TextBlock Text="Thème sombre à utiliser quand Windows est en mode sombre (Blanc en mode clair)"
                         Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
              <ComboBox x:Name="DarkThemeBox" DisplayMemberPath="Label" SelectedValuePath="Key" Width="280"
                        HorizontalAlignment="Left" SelectionChanged="DarkTheme_Changed"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,4">
              <TextBlock Text="Style visuel" VerticalAlignment="Center"/>
              <Border x:Name="BetaBadge" Visibility="Collapsed" Margin="10,0,0,0" Padding="8,0,8,1" CornerRadius="9"
                      BorderThickness="1" BorderBrush="{DynamicResource WarnBrush}" VerticalAlignment="Center">
                <TextBlock Text="BÊTA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"/>
              </Border>
            </StackPanel>
            <ComboBox x:Name="StyleBox" DisplayMemberPath="Label" SelectedValuePath="Key" Width="360"
                      HorizontalAlignment="Left" SelectionChanged="Style_Changed">
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                  <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                </Style>
              </ComboBox.ItemContainerStyle>
            </ComboBox>
            <TextBlock x:Name="BetaNote" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource WarnBrush}"
                       Text="Style expérimental et temporaire : il pourra être retiré dans une prochaine mise à jour. Vous reviendrez alors automatiquement au style Standard, avec vos autres préférences."/>

            <TextBlock Text="Couleur d'accent" Margin="0,16,0,4"/>
            <WrapPanel x:Name="AccentHost"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBox x:Name="HexBox" Width="110" MaxLength="7" ToolTip="Couleur personnalisée, ex. #4C8DF6" Margin="0,0,6,0"/>
              <Button Content="Appliquer" Click="ApplyHex_Click" Margin="0,3,6,3"/>
              <Button Content="Défaut du thème" Click="AccentDefault_Click"/>
            </StackPanel>

            <TextBlock x:Name="TransparencyLabel" Margin="0,16,0,4"/>
            <Slider x:Name="TransparencySlider" Minimum="0" Maximum="50" SmallChange="1" LargeChange="5"
                    Width="360" HorizontalAlignment="Left" ValueChanged="Transparency_Changed"/>
            <CheckBox x:Name="ReduceBox" Margin="0,10,0,0" Click="Reduce_Click"
                      Content="Mode sans transparence (toutes les surfaces opaques)"/>

            <TextBlock x:Name="NotesText" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>

            <Button x:Name="PrevBtn" Content="Revenir à l'apparence précédente" Click="Previous_Click"
                    HorizontalAlignment="Left" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10" Padding="14">
          <StackPanel>
            <TextBlock Text="Cache et exports" Style="{StaticResource PanelTitle}"/>
            <TextBox x:Name="WorkDirBox" IsReadOnly="True" Margin="0,2,0,6"/>
            <TextBlock x:Name="WorkDetailText" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Choisir un dossier…" Click="ChangeWorkDir_Click" Margin="0,3,6,3"/>
              <Button Content="Dossier par défaut" Click="ResetWorkDir_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource PanelBorder}" Padding="14">
          <StackPanel>
            <TextBlock Text="Assistant de bienvenue" Style="{StaticResource PanelTitle}"/>
            <Button Content="Relancer l'assistant…" Click="Relaunch_Click" HorizontalAlignment="Left" Margin="0,3,0,3"
                    ToolTip="Ferme les paramètres sans enregistrer les modifications en cours, puis ouvre l'assistant."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="1" x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="2,8,0,0"/>

    <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Enregistrer" Click="Save_Click"/>
      <Button DockPanel.Dock="Right" Content="Annuler" Click="Cancel_Click"/>
    </DockPanel>
  </Grid>
</Window>
