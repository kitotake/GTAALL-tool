<Window x:Class="GtaAll.App.TextureViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Textures" Width="1180" Height="720" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="470" MinWidth="320"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="300"/>
      </Grid.ColumnDefinitions>

      <!-- Liste des textures -->
      <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="TEXTURES" Style="{StaticResource PanelTitle}"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Filtre (hash, format, taille)" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            <TextBox x:Name="SearchBox" Width="140" Margin="8,0" TextChanged="Filter_Changed"/>
            <CheckBox x:Name="OkOnlyBox" Content="Décodables seulement" VerticalAlignment="Center" Click="Filter_Changed"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" x:Name="CountText" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/>
          <ListView x:Name="TextureList" SelectionChanged="Texture_Changed">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="#" DisplayMemberBinding="{Binding Index}" Width="46"/>
                <GridViewColumn Header="Hash" DisplayMemberBinding="{Binding Hash}" Width="140"/>
                <GridViewColumn Header="Taille" DisplayMemberBinding="{Binding SizeText}" Width="80"/>
                <GridViewColumn Header="Format" DisplayMemberBinding="{Binding FormatText}" Width="76"/>
                <GridViewColumn Header="État" DisplayMemberBinding="{Binding State}" Width="120"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

      <!-- Image -->
      <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="IMAGE (MIP 0)" Style="{StaticResource PanelTitle}"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Ajuster" Click="Fit_Click"/>
            <Button Content="100 %" Click="Actual_Click"/>
            <CheckBox x:Name="OpaqueBox" Content="Sans transparence" VerticalAlignment="Center" Margin="8,0" Click="Opaque_Click"/>
            <Button x:Name="ExportBtn" Content="Exporter PNG + DDS" Click="Export_Click" IsEnabled="False"/>
            <Button x:Name="ExportAllBtn" Content="Exporter tout (liste affichée)" Click="ExportAll_Click"/>
          </StackPanel>
          <TextBox x:Name="InfoText" DockPanel.Dock="Bottom" IsReadOnly="True" FontFamily="Consolas" Height="130" Margin="0,8,0,0"/>
          <Border BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
            <Border.Background>
              <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Viewbox="0,0,16,16" ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                  <DrawingGroup>
                    <GeometryDrawing Brush="#555555">
                      <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16"/>
                      </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#777777">
                      <GeometryDrawing.Geometry>
                        <GeometryGroup>
                          <RectangleGeometry Rect="0,0,8,8"/>
                          <RectangleGeometry Rect="8,8,8,8"/>
                        </GeometryGroup>
                      </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                  </DrawingGroup>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Border.Background>
            <ScrollViewer x:Name="PicScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
              <Image x:Name="Pic" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Barre d'état -->
    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="10,6" Margin="0,8,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </Border>
  </Grid>
</Window>
