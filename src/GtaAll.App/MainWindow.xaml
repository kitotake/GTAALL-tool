<Window x:Class="GtaAll.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTAALL-tool" Width="1280" Height="760">
  <DockPanel>
    <ToolBar DockPanel.Dock="Top">
      <Button Content="Ouvrir un dossier source…" Click="OpenSource_Click" Margin="2"/>
      <Button Content="Dossier cache/export…" Click="ChooseWork_Click" Margin="2"/>
      <Separator/>
      <Button x:Name="IndexBtn" Content="Indexer l'archive" Click="Index_Click" IsEnabled="False" Margin="2"/>
      <Button x:Name="CancelBtn" Content="Annuler" Click="Cancel_Click" IsEnabled="False" Margin="2"/>
      <Button x:Name="ExportBtn" Content="Exporter l'entrée" Click="Export_Click" IsEnabled="False" Margin="2"/>
    </ToolBar>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Prêt. Lecture seule : les sources ne sont jamais modifiées."/></StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right"><ProgressBar x:Name="Progress" Width="220" Height="14" Maximum="100"/></StatusBarItem>
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="340"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Fichiers reconnus" FontWeight="Bold" Margin="4"/>
        <ListView x:Name="SourceList" SelectionChanged="Source_Changed">
          <ListView.View><GridView>
            <GridViewColumn Header="Fichier" DisplayMemberBinding="{Binding RelativePath}" Width="170"/>
            <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="60"/>
            <GridViewColumn Header="Taille" DisplayMemberBinding="{Binding Size}" Width="70"/>
          </GridView></ListView.View>
        </ListView>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
          <TextBlock Text="Recherche (type ou offset hex) :" VerticalAlignment="Center"/>
          <TextBox x:Name="SearchBox" Width="180" Margin="6,0" TextChanged="Filter_Changed"/>
          <TextBlock Text="Type :" VerticalAlignment="Center"/>
          <ComboBox x:Name="KindBox" Width="110" Margin="6,0" SelectionChanged="Filter_Changed"/>
          <TextBlock x:Name="CountText" VerticalAlignment="Center"/>
        </StackPanel>
        <DataGrid x:Name="EntryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Entry_Changed"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Offset" Binding="{Binding Id}" Width="110"/>
            <DataGridTextColumn Header="Nom" Binding="{Binding NameText}" Width="140"/>
            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/>
            <DataGridTextColumn Header="Flux" Binding="{Binding StreamCount}" Width="50"/>
            <DataGridTextColumn Header="Compressé" Binding="{Binding CompressedSize}" Width="90"/>
            <DataGridTextColumn Header="Décompressé" Binding="{Binding InflatedSize}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

      <DockPanel Grid.Column="4">
        <TextBlock DockPanel.Dock="Top" Text="En-tête RPF9 (certitude)" FontWeight="Bold" Margin="4"/>
        <ListView DockPanel.Dock="Top" x:Name="HeaderList" Height="280">
          <ListView.View><GridView>
            <GridViewColumn Header="Off" DisplayMemberBinding="{Binding Offset}" Width="40"/>
            <GridViewColumn Header="Champ" DisplayMemberBinding="{Binding Name}" Width="120"/>
            <GridViewColumn Header="Valeur" DisplayMemberBinding="{Binding Value}" Width="100"/>
            <GridViewColumn Header="Certitude" DisplayMemberBinding="{Binding Confidence}" Width="70"/>
          </GridView></ListView.View>
        </ListView>
        <TextBlock DockPanel.Dock="Top" Text="Aperçu hexadécimal (32 premiers octets)" FontWeight="Bold" Margin="4"/>
        <TextBox x:Name="HexBox" DockPanel.Dock="Top" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Height="60"/>
        <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
