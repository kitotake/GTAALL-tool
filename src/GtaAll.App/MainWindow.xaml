<Window x:Class="GtaAll.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="GTAALL-tool" Width="1320" Height="780" MinWidth="980" MinHeight="560">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Barre d'actions -->
    <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="6" Margin="0,0,0,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Paramètres" Click="Settings_Click"/>
        <TextBlock DockPanel.Dock="Right" x:Name="WorkLabel" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="340" Margin="8,0"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="Ouvrir un dossier source…" Style="{StaticResource PrimaryButton}" Click="OpenSource_Click"/>
          <Button x:Name="IndexBtn" Content="Indexer l'archive" Click="Index_Click" IsEnabled="False"/>
          <Button x:Name="CancelBtn" Content="Annuler" Click="Cancel_Click" IsEnabled="False"/>
          <Button x:Name="ExportBtn" Content="Exporter l'entrée" Click="Export_Click" IsEnabled="False"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Zones de travail -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" MinWidth="220"/><ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="8"/>
        <ColumnDefinition Width="350" MinWidth="260"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="FICHIERS RECONNUS" Style="{StaticResource PanelTitle}"/>
          <ListView x:Name="SourceList" SelectionChanged="Source_Changed">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Fichier" DisplayMemberBinding="{Binding RelativePath}" Width="150"/>
                <GridViewColumn Header="Type" DisplayMemberBinding="{Binding TypeText}" Width="50"/>
                <GridViewColumn Header="Taille" DisplayMemberBinding="{Binding SizeText}" Width="80"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

      <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="ENTRÉES DE L'ARCHIVE" Style="{StaticResource PanelTitle}"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Recherche (type ou offset hex)" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            <TextBox x:Name="SearchBox" Width="170" Margin="8,0" TextChanged="Filter_Changed"/>
            <TextBlock Text="Type" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            <ComboBox x:Name="KindBox" Width="120" Margin="8,0" SelectionChanged="Filter_Changed"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
          </StackPanel>
          <DataGrid x:Name="EntryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Entry_Changed"
                    EnableRowVirtualization="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Offset" Binding="{Binding Id}" Width="110"/>
              <DataGridTextColumn Header="Nom" Binding="{Binding NameText}" Width="140"/>
              <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/>
              <DataGridTextColumn Header="Flux" Binding="{Binding StreamCount}" Width="50"/>
              <DataGridTextColumn Header="Compressé" Binding="{Binding CompressedSize}" Width="90"/>
              <DataGridTextColumn Header="Décompressé" Binding="{Binding InflatedSize}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>

      <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="EN-TÊTE RPF9 (CERTITUDE)" Style="{StaticResource PanelTitle}"/>
          <ListView DockPanel.Dock="Top" x:Name="HeaderList" Height="300">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Off" DisplayMemberBinding="{Binding Offset}" Width="40"/>
                <GridViewColumn Header="Champ" DisplayMemberBinding="{Binding Name}" Width="115"/>
                <GridViewColumn Header="Valeur" DisplayMemberBinding="{Binding Value}" Width="100"/>
                <GridViewColumn Header="Certitude" DisplayMemberBinding="{Binding Confidence}" Width="70"/>
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock DockPanel.Dock="Top" Text="APERÇU HEXADÉCIMAL (32 PREMIERS OCTETS)" Style="{StaticResource PanelTitle}" Margin="2,10,0,6"/>
          <TextBox x:Name="HexBox" DockPanel.Dock="Top" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Height="62"/>
          <TextBlock DockPanel.Dock="Top" Text="NOTES" Style="{StaticResource PanelTitle}" Margin="2,10,0,6"/>
          <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Barre d'état -->
    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="10,6" Margin="0,8,0,0">
      <DockPanel>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="220" Maximum="100" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
